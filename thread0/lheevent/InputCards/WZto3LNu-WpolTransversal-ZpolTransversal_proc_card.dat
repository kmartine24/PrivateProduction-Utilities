
import model sm-no_b_mass

define ell+ = e+ mu+ ta+
define ell- = e- mu- ta-
define vl = ve vm vt
define vl~ = ve~ vm~ vt~

generate p p > w+{T} z{T}, (w+ > ell+ vl), (z > ell+ ell-) @0
add process p p > w-{T} z{T}, (w- > ell- vl~), (z > ell+ ell-) @1

output WZto3LNu-WpolTransversal-ZpolTransversal
